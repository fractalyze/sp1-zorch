load("@rules_python//python:defs.bzl", "py_binary")
load("@sp1_zorch_pip//:requirements.bzl", "requirement")

py_binary(
    name = "staged_prove_shard",
    srcs = ["staged_prove_shard.py"],
    main = "staged_prove_shard.py",
    # Staged shard-prove harness over a local rsp GPU-trace capture
    # (~1.5 GB/shard, memory released between stages) — a runnable, not a
    # unit test:
    #   bazel run //tools:staged_prove_shard -- \
    #       --shard_dir=/path/to/rsp_dump/shardN
    deps = [
        "//sp1_zorch/shard_prover:staged_prove_shard",
        requirement("frx_cuda12_pjrt"),
        requirement("frx_cuda12_plugin"),
    ],
)
