# bazel 9 defaults to bzlmod (WORKSPACE is gone), so no enable flags needed.
build --announce_rc
test --test_output=errors

# Without this, rules_python synthesizes an empty __init__.py over every package
# that does not declare one in srcs. Under --override_module the dep's source
# tree is symlinked into the execroot, so the synthesized file lands on the
# ORIGINAL file and truncates it to zero bytes -- a local zorch checkout comes
# back with gutted __init__.py files it never asked to change.
build --incompatible_default_to_explicit_init_py

# Tests are backend-agnostic; CPU is the default (not a requirement) so plain
# `bazel test` is deterministic on any machine. CI overrides it per matrix leg
# via --test_env (the GPU leg pins FRX_PLATFORMS=cuda). Previously pinned
# per-target in each py_test's env, which made the backend unselectable from CI.
test --test_env=FRX_PLATFORMS=cpu

# Local, machine-specific overrides (gitignored). For dev against a local zorch
# working copy instead of the pinned git_override, add to .bazelrc.user:
#   common --override_module=zorch=/abs/path/to/your/zorch/checkout
try-import %workspace%/.bazelrc.user
