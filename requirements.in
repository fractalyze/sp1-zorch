# sp1-zorch runtime dependencies.
#
# Pulled from the Fractalyze package index alongside upstream PyPI:
#   pip install -r requirements.in \
#     --extra-index-url https://fractalyze.github.io/pypi/simple/
absl-py
numpy
# frx = Field, Ring Accelerated. Pins track zorch's requirements.in
# at the MODULE.bazel git_override commit — they build against a shared frxlib,
# so a lagging pin ABI-mismatches and segfaults the GPU tests.
frx==0.10.2.dev20260819075820
frxlib==0.10.2.dev20260819075820
frx-cuda12-pjrt==0.10.2.dev20260819075820
# [with-cuda] carries the nvidia-*-cu12 wheels; the plugin loads CUDA only from
# installed `nvidia.*` packages, never a host toolkit (#310).
frx-cuda12-plugin[with-cuda]==0.10.2.dev20260819075820
# 12.9.x ptxas SIGSEGVs shard0's GKR cold compile (#210); the extra only floors.
nvidia-cuda-nvcc-cu12==12.8.93
zk-dtypes==0.0.10

# The symmetric layer (permutations, sponges, compressions). It sits BELOW
# `zorch`, which imports it rather than owning a copy, so this repo takes it
# directly — the same distribution-name rule as frx above: pip resolves here on
# a separate hub from zorch's, so a shared distribution must be named in both.
hash-frx==0.2.0.dev20260819071642

# SP1 chip definitions (constraints + LogUp interactions) exported from
# riscv-witness; consumed by the shard fixture loader. Same pin as whir-zorch.
rw-constraints @ https://github.com/fractalyze/pypi/releases/download/riscv-witness-dev-20260703070602/rw_constraints-0.1.0.dev20260703070602-py3-none-any.whl
