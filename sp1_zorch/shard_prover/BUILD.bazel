        "//sp1_zorch/poseidon2:koalabear16",
        "@zorch//zorch/commit:smcs",
        "@zorch//zorch/poly",
        requirement("absl_py"),
        requirement("frx"),
        requirement("hash_frx"),
        requirement("zk_dtypes"),
    ],
)

