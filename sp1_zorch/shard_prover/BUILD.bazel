load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@sp1_zorch_pip//:requirements.bzl", "requirement")

# Shard prover input loading: SP1 GPU-dump fixtures + rw_constraints chips.
py_library(
    name = "shard_prover",
    srcs = [
        "chip_loader.py",
        "fixture_loader.py",
        "serialize.py",
    ],
    visibility = ["//visibility:public"],
    # serialize.py's jagged imports are TYPE_CHECKING-only by design — adding
    # the jagged deps here swaps consumers' frx wheel via pip-hub sys.path
    # shadowing (#60).
    deps = [
        "//sp1_zorch:types",
        requirement("frx"),
        requirement("numpy"),
        requirement("rw_constraints"),
        requirement("zk_dtypes"),
    ],
)

# One definition of the shard compile-class math (tight zerocheck/GKR/jagged
# classes) + the manifest/flag pin resolution, shared by the staged prove
# harness (//tools:staged_prove_shard) and the warm cache filler so the two
# cannot drift on what keys a compile.
py_library(
    name = "compile_classes",
    srcs = ["compile_classes.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//sp1_zorch/logup_gkr",
        "//sp1_zorch/zerocheck",
    ],
)

py_test(
    name = "compile_classes_test",
    size = "small",
    srcs = ["compile_classes_test.py"],
    deps = [
        ":compile_classes",
        "//sp1_zorch/logup_gkr",
        "//sp1_zorch/zerocheck",
        requirement("absl_py"),
    ],
)

# Shared scaffolding for the verify_* byte-match runnables: SP1's duplex
# challenger, the shard preamble stream, and the core-machine jagged regions.
py_library(
    name = "replay",
    srcs = ["replay.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":prove_shard",
        ":shard_prover",
        "//sp1_zorch/logup_gkr",
        "//sp1_zorch/poseidon2:koalabear16",
        "@zorch//zorch:transcript",
        "@zorch//zorch/pcs/jagged:region",
        requirement("frx"),
        requirement("hash_frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

# Shard ingest from a co-located trace-gen producer: device frx.Array traces
# in, the fixture path's regions/ShardData out (no dump files). Its own target
# (not a :shard_prover src) because it imports zorch's jagged region at
# runtime — the dep :shard_prover must not carry (#60).
py_library(
    name = "producer_loader",
    srcs = ["producer_loader.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":replay",
        ":shard_prover",
        "@zorch//zorch/pcs/jagged:region",
        requirement("frx"),
        requirement("zk_dtypes"),
    ],
)

py_test(
    name = "producer_loader_test",
    size = "small",
    srcs = ["producer_loader_test.py"],
    deps = [
        ":producer_loader",
        ":replay",
        ":shard_prover",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

