# Host-bytes ctypes binding for SP1's shard verifier (no JAX involvement).
py_library(
    name = "sp1_ffi",
    srcs = ["sp1_ffi.py"],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "warm_shard_cache",
    srcs = [
        "warm_shard_cache.py",
        "warm_worker.py",
    ],
    main = "warm_shard_cache.py",
    # Analyze a shard dump for optimal grouped compilation + parallel
    # persistent-cache fill:
    #   bazel run //sp1_zorch/shard_prover:warm_shard_cache -- \
    #       --dump_dir=/path/to/rsp_dump --out_manifest=/tmp/manifest.json
    deps = [
        ":compile_classes",
        ":prove_shard",
        ":replay",
        ":shard_prover",
        ":sp1_ffi",
        "//sp1_zorch:types",
        "//sp1_zorch/logup_gkr",
        "//sp1_zorch/poseidon2:koalabear16",
        "//sp1_zorch/zerocheck",
        # warm_worker drives the staged harness main under its frx.jit
        # intercept, so the warmed executables match a real staged prove.
        ":staged_prove_shard",
        "@zorch//zorch/commit:smcs",
        "@zorch//zorch/poly",
        requirement("absl_py"),
        requirement("frx"),
        requirement("frx_cuda12_plugin"),
        requirement("hash_frx"),
        requirement("zk_dtypes"),
        requirement("frx_cuda12_pjrt"),
    ],
)

py_test(
    name = "warm_shard_cache_test",
    size = "small",
    srcs = [
        "warm_shard_cache.py",
        "warm_shard_cache_test.py",
    ],
    # Pure selection/cover logic, no GPU and no dump; the warm tool is a
    # py_binary, so its module rides along as a src. --dump_dir is a required
    # tool flag the test never reads — satisfy the parser.
    args = ["--dump_dir=unused"],
    main = "warm_shard_cache_test.py",
    deps = [
        ":compile_classes",
        ":prove_shard",
        ":replay",
        ":shard_prover",
        ":sp1_ffi",
        "//sp1_zorch:types",
        "//sp1_zorch/logup_gkr",
        "//sp1_zorch/poseidon2:koalabear16",
        "//sp1_zorch/zerocheck",
        "@zorch//zorch/commit:smcs",
        "@zorch//zorch/poly",
        requirement("absl_py"),
        requirement("frx"),
        requirement("hash_frx"),
        requirement("zk_dtypes"),
    ],
)

