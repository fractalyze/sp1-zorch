load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@sp1_zorch_pip//:requirements.bzl", "requirement")

# The jagged PCS roles: commit the shard's trace regions, and open them at the
# point zerocheck reduces to. Kept out of zorch because the body reads SP1
# shard structure (chip names, the preprocessed/main split).
py_library(
    name = "jagged_pcs",
    srcs = [
        "__init__.py",
        "prover.py",
        "verifier.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//sp1_zorch:types",
        "//sp1_zorch/shard_prover",
        "@zorch//zorch:stage",
        "@zorch//zorch:transcript",
        "@zorch//zorch/coding:reed_solomon",
        "@zorch//zorch/commit:smcs",
        "@zorch//zorch/pcs/jagged:commit",
        "@zorch//zorch/pcs/jagged:open",
        "@zorch//zorch/pcs/jagged:prover",
        "@zorch//zorch/pcs/jagged:region",
        "@zorch//zorch/pcs/jagged:verifier",
        "@zorch//zorch/poly",
        "@zorch//zorch/utils:bits",
        requirement("frx"),
        requirement("zk_dtypes"),
    ],
)

py_test(
    name = "prover_test",
    # medium/long: ~16 tiny CPU opens (chunked-vs-monolithic byte identity
    # across widths and jit modes) plus the chunk-zone CPU compiles; a loaded
    # shared CI runner can overrun the medium 300s cap.
    size = "medium",
    timeout = "long",
    srcs = ["prover_test.py"],
    deps = [
        ":jagged_pcs",
        "//sp1_zorch:types",
        "//sp1_zorch/poseidon2:koalabear16",
        "@zorch//zorch/commit:smcs",
        "@zorch//zorch/hash:compression",
        "@zorch//zorch/hash:sponge",
        "@zorch//zorch/hash/poseidon2",
        "@zorch//zorch/pcs/jagged:commit",
        "@zorch//zorch/pcs/jagged:region",
        "@zorch//zorch/testkit:transcript",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)
